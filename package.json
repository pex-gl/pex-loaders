{
  "name": "pex-loaders",
  "version": "2.0.0-alpha.4",
  "description": "Resource loader for PEX.",
  "keywords": [
    "pex",
    "renderer",
    "webgl",
    "3d",
    "loaders",
    "gltf",
    "basis",
    "ktx",
    "draco",
    "hdr",
    "ultra-hdr",
    "exr"
  ],
  "homepage": "https://github.com/pex-gl/pex-loaders",
  "bugs": "https://github.com/pex-gl/pex-loaders/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pex-gl/pex-loaders.git"
  },
  "license": "MIT",
  "author": "Damien Seguin (https://github.com/dmnsgn)",
  "contributors": [
    "Marcin Ignac <marcin.ignac@gmail.com> (http://marcinignac.com)"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "build": "snowdev build",
    "dev": "snowdev dev",
    "release": "snowdev release",
    "release:alpha": "snowdev release --release-as minor --prerelease alpha",
    "vendor:draco": "node scripts/vendor-draco.js"
  },
  "dependencies": {
    "ktx-parse": "^2.0.0",
    "parse-exr": "^1.0.2",
    "parse-hdr": "^1.0.0",
    "pex-io": "^3.3.0",
    "pex-math": "^4.5.0",
    "zstddec": "^0.3.4"
  },
  "devDependencies": {
    "draco3d": "^1.5.9",
    "pex-gpu": "^0.0.5"
  },
  "peerDependencies": {
    "pex-gpu": "*"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=26.0.0",
    "snowdev": ">=3.0.0-alpha.3"
  },
  "snowdev": {
    "serve": false
  }
}
